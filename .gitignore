# ---------------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ---------------------------------------------------------------------------
# Xcode — user-specific state
# ---------------------------------------------------------------------------
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.perspectivev3
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3

# Shared schemes ARE committed (see IdleTapper.xcodeproj/xcshareddata) so that
# `xcodebuild -scheme IdleTapper` works on a fresh clone.

# ---------------------------------------------------------------------------
# Xcode — build products
# ---------------------------------------------------------------------------
build/
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcarchive
*.app
timeline.xctimeline
playground.xcworkspace

# ---------------------------------------------------------------------------
# Swift Package Manager
# ---------------------------------------------------------------------------
.build/
.swiftpm/
Packages/
Package.pins
Package.resolved
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

# ---------------------------------------------------------------------------
# Dependency managers (not used today, ignored defensively)
# ---------------------------------------------------------------------------
Pods/
Carthage/Build/

# ---------------------------------------------------------------------------
# SwiftData / Core Data local stores
#
# The app writes default.store plus its write-ahead log and shared-memory
# sidecars. All three make up the database — none belong in git.
# ---------------------------------------------------------------------------
*.store
*.store-wal
*.store-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
*.p12
*.mobileprovision
*.cer
ExportOptions.plist

# ---------------------------------------------------------------------------
# Local scratch work — never committed
# ---------------------------------------------------------------------------
scripts/local/
.local/

# ---------------------------------------------------------------------------
# Editors
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*~
